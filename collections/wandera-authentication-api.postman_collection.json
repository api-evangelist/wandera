  "info": {
    "_postman_id": "fcd09836-3f0b-4d5b-b9e5-b364d46d896c",
    "name": "Wandera RADAR Risk Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Wandera (Jamf Security Cloud / RADAR) Risk API lets security integrations query the risk states of enrolled mobile and desktop devices and override the risk classification of specific devices. Authentication uses a short-lived JSON Web Token (JWT, 15 minute validity) obtained by exchanging an Application ID and Application Secret via HTTP Basic authorization. Wandera was acquired by Jamf in July 2021; the API continues to be served on the api.wandera.com host and is documented on the Jamf Developer portal.\n\nContact Support:\n Name: Jamf Developer (Wandera / Jamf Security Cloud)",
      "type": "text/plain"
    }
  }
