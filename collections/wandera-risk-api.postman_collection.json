          "name": "List device risk states",
          "request": {
            "name": "List device risk states",
            "description": {
              "content": "Query the risk states of enrolled devices. Results are paginated; the maximum page size is 100 records. Returns device information including device IDs, risk status, OS type and version, and device location.",
              "type": "text/plain"
            },
