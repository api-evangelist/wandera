          "id": "4a6ebf20-c906-4f80-a754-54fe5bbe5623",
          "name": "Override device risk classification",
          "request": {
            "name": "Override device risk classification",
            "description": {
              "content": "Override the risk classification for one or more devices. The body specifies the target risk level, the source of the override, and the list of device IDs to apply it to.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "risk",
                "v1",
                "override"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
