                  "key": "page",
                  "value": "<integer>",
                  "description": "Zero-based page index. Must not be negative."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "Number of records per page. Maximum is 100."
                }
              ],
              "variable": []
            },
